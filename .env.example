# Copy this file to .env and fill in real values.
# Never commit .env. It is in .gitignore for a reason.
# For deploys, paste these into Vercel's Environment Variables panel, never into code.

# Anthropic (required for Lane 3 AI Work Agent projects)
ANTHROPIC_API_KEY=

# OpenAI (optional, for Codex fallback)
OPENAI_API_KEY=

# Common integrations (uncomment and fill what you need)
# NOTION_API_KEY=
# AIRTABLE_API_KEY=
# GOOGLE_SHEETS_CREDENTIALS=
# SLACK_BOT_TOKEN=
# LINEAR_API_KEY=
# STRIPE_SECRET_KEY=

# Auth (when you patch in v2)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
